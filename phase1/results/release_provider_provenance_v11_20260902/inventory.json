  "annotation_notes": {
    "deepseek_version_boundary": "gen2C/gen2D/t3c*/t3g* collected 0730, gen3A and t3gB span 0731; the flip day itself is uncertain to +-1 day, treat 0730-0731 collections as version-ambiguous in analyses",
