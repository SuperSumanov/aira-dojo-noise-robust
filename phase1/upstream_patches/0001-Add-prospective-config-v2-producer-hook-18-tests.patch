+def test_collection_rejects_duplicate_tamper_and_noncanonical_input(tmp_path: Path) -> None:
+    first = emit(tmp_path / "one", "family_seed_1_id_aaaa1111")
+    with pytest.raises(sidecar.SidecarError, match="duplicate"):
+        sidecar.collect_sidecars([first, first], output=tmp_path / "duplicate.jsonl")
+    assert not (tmp_path / "duplicate.jsonl").exists()
+
+    row = json.loads(first.read_text())
+    row["experiment_stratum_sha256"] = "f" * 64
+    tampered = tmp_path / "tampered.jsonl"
+    tampered.write_text(sidecar.canonical_json(row) + "\n", encoding="utf-8")
+    with pytest.raises(sidecar.SidecarError, match="fingerprint mismatch"):
+        sidecar.collect_sidecars([tampered], output=tmp_path / "tampered-batch.jsonl")
+
+    noncanonical = tmp_path / "noncanonical.jsonl"
+    noncanonical.write_text(json.dumps(json.loads(first.read_text())) + "\n", encoding="utf-8")
+    with pytest.raises(sidecar.SidecarError, match="not canonical"):
+        sidecar.collect_sidecars([noncanonical], output=tmp_path / "noncanonical-batch.jsonl")
+
