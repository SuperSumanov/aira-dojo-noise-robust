+def test_resume_reuses_only_a_byte_identical_sidecar(tmp_path: Path) -> None:
+    first_path, first_sha = sidecar.maybe_emit_for_resolved_run(
+        resolved_config(), output_dir=tmp_path, environ=enabled_env()
+    )
+    first_raw = first_path.read_bytes()
+    second_path, second_sha = sidecar.maybe_emit_for_resolved_run(
+        resolved_config(), output_dir=tmp_path, environ=enabled_env()
+    )
+    assert first_path == second_path
+    assert first_sha == second_sha
+    assert second_path.read_bytes() == first_raw
+
+    changed = resolved_config(prompt="changed on resume")
+    with pytest.raises(sidecar.SidecarError, match="already exists"):
+        sidecar.maybe_emit_for_resolved_run(
+            changed, output_dir=tmp_path, environ=enabled_env()
+        )
+    assert first_path.read_bytes() == first_raw
