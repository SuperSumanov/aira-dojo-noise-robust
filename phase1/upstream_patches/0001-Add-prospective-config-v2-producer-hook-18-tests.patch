+def test_collection_is_order_invariant_and_atomic(tmp_path: Path) -> None:
+    first = emit(tmp_path / "one", "family_seed_1_id_aaaa1111")
+    second = emit(tmp_path / "two", "family_seed_2_id_bbbb2222")
+    output_ab = tmp_path / "ab.config_v2.jsonl"
+    output_ba = tmp_path / "ba.config_v2.jsonl"
+    rows_ab, sha_ab = sidecar.collect_sidecars([first, second], output=output_ab)
+    rows_ba, sha_ba = sidecar.collect_sidecars([second, first], output=output_ba)
+    assert rows_ab == rows_ba == 2
+    assert sha_ab == sha_ba
+    assert output_ab.read_bytes() == output_ba.read_bytes()
+    assert [json.loads(line)["run_id"] for line in output_ab.read_text().splitlines()] == [
+        "family_seed_1_id_aaaa1111__2026-08-27",
+        "family_seed_2_id_bbbb2222__2026-08-27",
+    ]
+
