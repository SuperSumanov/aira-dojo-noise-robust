--- /dev/null
+++ b/src/dojo/utils/config_v2_sidecar.py
@@ -0,0 +1,399 @@
+"""Outcome-before, credential-safe config-v2 sidecars for prospective runs.
+
+This module is deliberately independent of the analysis tree.  The producer
+passes an already resolved public run config and receives a single canonical
+JSONL row containing public metadata and SHA-256 fingerprints only.  No
+outcome, grade, prediction, journal, archive, or environment dump is read.
+"""
+
+from __future__ import annotations
+
+import argparse
+import copy
+import datetime as dt
+import hashlib
+import json
+import math
+import os
+import re
+from pathlib import Path
+from typing import Any, Iterable, Mapping
+
+
+PROTOCOL = "senior-experiment-config-manifest-v2"
+SOLVER_PROJECTION_SCHEMA = "resolved-solver-minus-run-paths-v1"
+PER_RUN_FILENAME = "producer.config_v2.jsonl"
+ENABLE_ENV = "DOJO_CONFIG_V2_SIDECAR"
+RELEASE_ENV = "DOJO_GENERATOR_RELEASE"
+VOLATILE_SOLVER_FIELDS = {"exp_name", "checkpoint_path"}
+CONFIG_FIELDS = {
+    "client",
+    "execution_timeout",
+    "experiment_stratum_sha256",
+    "generator_release",
+    "hardware",
+    "resolved_solver_config_sha256",
+    "run_id",
+    "solver_projection_schema",
+    "task",
+    "time_limit",
+}
+RUN_RE = re.compile(r"^(.+_seed_[0-9]+_id_[0-9a-f]+)__(\d{4}-\d{2}-\d{2})$")
+SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
+PUBLIC_VALUE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:/+() @-]{0,199}$")
+CREDENTIAL = re.compile(
+    rb"(?:^|[^A-Za-z0-9])(?:sk-[A-Za-z0-9._-]{16,}|hf_[A-Za-z0-9]{16,}|"
+    rb"gh[pousr]_[A-Za-z0-9]{16,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{30,}|"
+    rb"Bearer[ \t]+[A-Za-z0-9._-]{20,}|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----)"
+)
+
+
+class SidecarError(RuntimeError):
+    """Raised when a prospective sidecar operation must fail closed."""
+
+
+def canonical_json(value: Any) -> str:
+    """Return the protocol's canonical finite JSON representation."""
+    return json.dumps(
+        value,
+        ensure_ascii=False,
+        sort_keys=True,
+        separators=(",", ":"),
+        allow_nan=False,
+    )
+
+
+def _sha256(raw: bytes) -> str:
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _credential_safe(raw: bytes, label: str) -> None:
+    if CREDENTIAL.search(raw):
+        raise SidecarError(f"credential-shaped bytes refused in {label}")
+
+
+def _public_value(value: Any, label: str) -> str:
+    if (
+        not isinstance(value, str)
+        or value != value.strip()
+        or PUBLIC_VALUE_RE.fullmatch(value) is None
+    ):
+        raise SidecarError(f"{label} is not a credential-safe public identifier")
+    return value
+
+
+def _positive_number(value: Any, label: str) -> int | float:
+    if (
+        isinstance(value, bool)
+        or not isinstance(value, (int, float))
+        or not math.isfinite(float(value))
+        or value <= 0
+    ):
+        raise SidecarError(f"{label} must be a positive finite JSON number")
+    return value
+
+
+def _solver_projection(config: Mapping[str, Any]) -> dict[str, Any]:
+    solver = config.get("solver")
+    if not isinstance(solver, dict) or not solver:
+        raise SidecarError("resolved solver object is absent")
+    projected = copy.deepcopy(solver)
+    for field in VOLATILE_SOLVER_FIELDS:
+        projected.pop(field, None)
+    if not projected:
+        raise SidecarError("resolved solver projection is empty")
+    return projected
+
+
+def _resolved_solver_sha256(config: Mapping[str, Any]) -> str:
+    try:
+        raw = canonical_json(_solver_projection(config)).encode("utf-8")
+    except (TypeError, ValueError) as exc:
+        raise SidecarError("resolved solver projection is not finite canonical JSON") from exc
+    _credential_safe(raw, "resolved solver projection")
+    return _sha256(raw)
+
+
+def _run_id(config: Mapping[str, Any]) -> str:
+    source_id = config.get("id")
+    metadata = config.get("metadata")
+    launch_time = metadata.get("launch_time") if isinstance(metadata, dict) else None
+    if not isinstance(source_id, str) or not source_id:
+        raise SidecarError("resolved run id is absent")
+    if not isinstance(launch_time, str):
+        raise SidecarError("resolved launch_time is absent")
+    match = re.match(r"^(\d{4}-\d{2}-\d{2})", launch_time)
+    if match is None:
+        raise SidecarError("resolved launch_time has no ISO date")
+    try:
+        dt.date.fromisoformat(match.group(1))
+    except ValueError as exc:
+        raise SidecarError("resolved launch date is invalid") from exc
+    run_id = f"{source_id}__{match.group(1)}"
+    if RUN_RE.fullmatch(run_id) is None:
+        raise SidecarError("derived physical run ID violates the prospective contract")
+    return run_id
+
+
+def _uniform_operator_client(config: Mapping[str, Any]) -> str:
+    solver = config.get("solver")
+    operators = solver.get("operators") if isinstance(solver, dict) else None
+    if not isinstance(operators, dict) or not operators:
+        raise SidecarError("resolved solver operators are absent")
+    clients: dict[str, str] = {}
+    for operator, value in operators.items():
+        if not isinstance(value, dict) or "llm" not in value:
+            continue
+        try:
+            model_id = value["llm"]["client"]["model_id"]
+        except (KeyError, TypeError) as exc:
+            raise SidecarError(f"operator client is malformed: {operator}") from exc
+        if not isinstance(model_id, str) or not model_id:
+            raise SidecarError(f"operator client is invalid: {operator}")
+        clients[str(operator)] = model_id
+    if "draft" not in clients:
+        raise SidecarError("draft operator client is absent")
+    if len(set(clients.values())) != 1:
+        raise SidecarError("operator clients are mixed; scalar client would be ambiguous")
+    return clients["draft"]
+
+
+def _experiment_stratum_sha256(row: Mapping[str, Any]) -> str:
+    payload = (
+        row["task"],
+        row["client"],
+        row["generator_release"],
+        row["hardware"],
+        row["time_limit"],
+        row["execution_timeout"],
+        row["solver_projection_schema"],
+        row["resolved_solver_config_sha256"],
+    )
+    try:
+        raw = json.dumps(
+            payload,
+            ensure_ascii=False,
+            separators=(",", ":"),
+            allow_nan=False,
+        ).encode("utf-8")
+    except (TypeError, ValueError) as exc:
+        raise SidecarError("experiment stratum is not finite canonical JSON") from exc
+    return _sha256(raw)
+
+
+def make_row(
+    config: Mapping[str, Any], *, generator_release: str, hardware: str
+) -> dict[str, Any]:
+    """Create one v2 row from a resolved, in-memory producer config."""
+    try:
+        config_raw = canonical_json(config).encode("utf-8")
+    except (TypeError, ValueError) as exc:
+        raise SidecarError("resolved run config is not finite canonical JSON") from exc
+    _credential_safe(config_raw, "resolved run config")
+
+    task_config = config.get("task")
+    task = task_config.get("name") if isinstance(task_config, dict) else None
+    solver = config.get("solver")
+    if not isinstance(solver, dict):
+        raise SidecarError("resolved solver is absent")
+    try:
+        time_limit = solver["time_limit_secs"]
+        execution_timeout = solver["execution_timeout"]
+    except KeyError as exc:
+        raise SidecarError("solver time limits are absent") from exc
+
+    row: dict[str, Any] = {
+        "client": _uniform_operator_client(config),
+        "execution_timeout": _positive_number(execution_timeout, "execution_timeout"),
+        "experiment_stratum_sha256": "0" * 64,
+        "generator_release": _public_value(generator_release, "generator_release"),
+        "hardware": _public_value(hardware, "hardware"),
+        "resolved_solver_config_sha256": _resolved_solver_sha256(config),
+        "run_id": _run_id(config),
+        "solver_projection_schema": SOLVER_PROJECTION_SCHEMA,
+        "task": _public_value(task, "task"),
+        "time_limit": _positive_number(time_limit, "time_limit"),
+    }
+    _public_value(row["client"], "client")
+    row["experiment_stratum_sha256"] = _experiment_stratum_sha256(row)
+    return row
+
+
+def validate_row(row: Any) -> dict[str, Any]:
+    """Independently validate a row before collection or publication."""
+    if not isinstance(row, dict) or set(row) != CONFIG_FIELDS:
+        raise SidecarError("config-v2 row schema mismatch")
+    for field in ("task", "client", "generator_release", "hardware"):
+        _public_value(row[field], field)
+    _positive_number(row["time_limit"], "time_limit")
+    _positive_number(row["execution_timeout"], "execution_timeout")
+    if RUN_RE.fullmatch(row.get("run_id", "")) is None:
+        raise SidecarError("config-v2 row run_id is invalid")
+    if row.get("solver_projection_schema") != SOLVER_PROJECTION_SCHEMA:
+        raise SidecarError("config-v2 solver projection schema mismatch")
+    if SHA256_RE.fullmatch(row.get("resolved_solver_config_sha256", "")) is None:
+        raise SidecarError("config-v2 solver fingerprint is invalid")
+    if row.get("experiment_stratum_sha256") != _experiment_stratum_sha256(row):
+        raise SidecarError("config-v2 experiment stratum fingerprint mismatch")
+    raw = (canonical_json(row) + "\n").encode("utf-8")
+    _credential_safe(raw, "config-v2 row")
+    return row
+
+
+def render_rows(rows: Iterable[dict[str, Any]]) -> bytes:
+    """Validate, sort, and render a complete canonical sidecar batch."""
+    values = [validate_row(dict(row)) for row in rows]
+    if not values:
+        raise SidecarError("refusing to render an empty config-v2 batch")
+    values.sort(key=lambda row: row["run_id"].encode("utf-8"))
+    run_ids = [row["run_id"] for row in values]
+    if len(run_ids) != len(set(run_ids)):
+        raise SidecarError("duplicate physical run ID in config-v2 batch")
+    raw = "".join(canonical_json(row) + "\n" for row in values).encode("utf-8")
+    _credential_safe(raw, "config-v2 batch")
+    return raw
+
+
+def write_fresh_atomic(
+    path_value: str | Path, raw: bytes, *, allow_identical_existing: bool = False
+) -> str:
+    """Publish immutable bytes atomically without a check/replace race."""
+    unresolved = Path(path_value)
+    if unresolved.is_symlink():
+        raise SidecarError("config-v2 output already exists or is symlinked")
+    if unresolved.exists():
+        if (
+            allow_identical_existing
+            and unresolved.is_file()
+            and unresolved.read_bytes() == raw
+        ):
+            return _sha256(raw)
+        raise SidecarError("config-v2 output already exists or is symlinked")
+    path = unresolved.resolve()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_name(path.name + f".tmp-{os.getpid()}")
+    if temporary.exists():
+        raise SidecarError("config-v2 temporary output already exists")
+    try:
+        with temporary.open("xb") as handle:
+            handle.write(raw)
+            handle.flush()
+            os.fsync(handle.fileno())
+        try:
+            os.link(temporary, path)
+        except FileExistsError as exc:
+            if (
+                allow_identical_existing
+                and path.is_file()
+                and not path.is_symlink()
+                and path.read_bytes() == raw
+            ):
+                return _sha256(raw)
+            raise SidecarError("config-v2 output appeared during atomic publish") from exc
+        temporary.unlink()
+    finally:
+        if temporary.exists():
+            temporary.unlink()
+    return _sha256(raw)
+
+
+def emit_for_resolved_run(
+    config: Mapping[str, Any],
+    *,
+    output_dir: str | Path,
+    generator_release: str,
+    hardware: str,
+) -> tuple[Path, str]:
+    """Write one immutable per-run sidecar before solver execution."""
+    row = make_row(
+        config,
+        generator_release=generator_release,
+        hardware=hardware,
+    )
+    raw = render_rows([row])
+    path = Path(output_dir) / PER_RUN_FILENAME
+    return path, write_fresh_atomic(path, raw, allow_identical_existing=True)
+
+
+def maybe_emit_for_resolved_run(
+    config: Mapping[str, Any],
+    *,
+    output_dir: str | Path,
+    environ: Mapping[str, str] | None = None,
+) -> tuple[Path, str] | None:
+    """Emit only when explicitly enabled; reject misspelled nonempty flags."""
+    values = os.environ if environ is None else environ
+    enabled = values.get(ENABLE_ENV, "")
+    if enabled in {"", "0"}:
+        return None
+    if enabled != "1":
+        raise SidecarError(f"{ENABLE_ENV} must be exactly 0 or 1")
+    release = values.get(RELEASE_ENV)
+    if release is None or not release:
+        raise SidecarError(f"{RELEASE_ENV} is required when config-v2 sidecars are enabled")
+    hardware = values.get("HARDWARE")
+    if hardware is None or not hardware:
+        raise SidecarError("HARDWARE is required when config-v2 sidecars are enabled")
+    return emit_for_resolved_run(
+        config,
+        output_dir=output_dir,
+        generator_release=release,
+        hardware=hardware,
+    )
+
+
+def load_one_sidecar(path_value: str | Path) -> dict[str, Any]:
+    """Load exactly one canonical, credential-safe per-run sidecar."""
+    unresolved = Path(path_value)
+    if unresolved.is_symlink() or not unresolved.is_file():
+        raise SidecarError("input sidecar is absent, non-regular, or symlinked")
+    raw = unresolved.resolve().read_bytes()
+    _credential_safe(raw, "input sidecar")
+    try:
+        lines = raw.decode("utf-8").splitlines()
+    except UnicodeDecodeError as exc:
+        raise SidecarError("input sidecar is not UTF-8") from exc
+    if len(lines) != 1 or not lines[0]:
+        raise SidecarError("input sidecar must contain exactly one nonblank row")
+    try:
+        row = json.loads(lines[0])
+    except json.JSONDecodeError as exc:
+        raise SidecarError("input sidecar is invalid JSON") from exc
+    validated = validate_row(row)
+    if raw != (canonical_json(validated) + "\n").encode("utf-8"):
+        raise SidecarError("input sidecar is not canonical JSONL")
+    return validated
+
+
+def collect_sidecars(
+    sidecar_paths: Iterable[str | Path], *, output: str | Path
+) -> tuple[int, str]:
+    """Atomically merge explicitly named per-run sidecars without outcome reads."""
+    paths = list(sidecar_paths)
+    if not paths:
+        raise SidecarError("at least one explicit per-run sidecar is required")
+    rows = [load_one_sidecar(path) for path in paths]
+    raw = render_rows(rows)
+    return len(rows), write_fresh_atomic(output, raw)
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description="Merge prospective config-v2 sidecars.")
+    parser.add_argument("--sidecar", action="append", required=True)
+    parser.add_argument("--output", required=True)
+    return parser.parse_args()
+
+
+def main() -> int:
+    args = parse_args()
+    try:
+        rows, manifest_sha256 = collect_sidecars(args.sidecar, output=args.output)
+    except (OSError, SidecarError) as exc:
+        print(f"CONFIG_V2_COLLECT_FAIL type={type(exc).__name__}", file=os.sys.stderr)
+        return 2
+    print(f"CONFIG_V2_COLLECT_PASS rows={rows} manifest_sha256={manifest_sha256}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/test_config_v2_sidecar.py b/tests/test_config_v2_sidecar.py
new file mode 100644
index 0000000..bd61878
--- /dev/null
+++ b/tests/test_config_v2_sidecar.py
@@ -0,0 +1,308 @@
+from __future__ import annotations
+
+import copy
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+from dojo.utils import config_v2_sidecar as sidecar
+
+
+def resolved_config(
+    run_name: str = "family_seed_7_id_abcd1234",
+    *,
+    prompt: str = "static policy v1",
+    model: str = "qwen3-coder-flash",
+) -> dict:
+    return {
+        "id": run_name,
+        "logger": {"output_dir": f"outputs/{run_name}"},
+        "metadata": {"launch_time": "2026-08-27T01:02:03Z"},
+        "task": {"name": "task-a", "benchmark": "mlebench"},
+        "solver": {
+            "exp_name": run_name,
+            "checkpoint_path": f"outputs/{run_name}/checkpoint",
+            "step_limit": 20,
+            "time_limit_secs": 1200,
+            "execution_timeout": 600,
+            "operators": {
+                "draft": {
+                    "system_prompt": prompt,
+                    "prompt": "dynamic context: {task}",
+                    "llm": {"client": {"model_id": model}},
+                },
+                "improve": {
+                    "system_prompt": "improve policy",
+                    "prompt": "improve context: {task}",
+                    "llm": {"client": {"model_id": model}},
+                },
+            },
+        },
+    }
+
+
+def enabled_env() -> dict[str, str]:
+    return {
+        sidecar.ENABLE_ENV: "1",
+        sidecar.RELEASE_ENV: "qwen-release-2026-08",
+        "HARDWARE": "NVIDIA H200",
+    }
+
+
+def test_default_is_disabled_and_creates_nothing(tmp_path: Path) -> None:
+    assert (
+        sidecar.maybe_emit_for_resolved_run(
+            resolved_config(), output_dir=tmp_path, environ={}
+        )
+        is None
+    )
+    assert list(tmp_path.iterdir()) == []
+
+
+def test_enabled_emission_is_canonical_and_hash_bound(tmp_path: Path) -> None:
+    path, manifest_sha256 = sidecar.maybe_emit_for_resolved_run(
+        resolved_config(), output_dir=tmp_path, environ=enabled_env()
+    )
+    raw = path.read_bytes()
+    assert path.name == sidecar.PER_RUN_FILENAME
+    assert manifest_sha256 == sidecar.hashlib.sha256(raw).hexdigest()
+    assert raw.endswith(b"\n") and b"\r" not in raw
+    row = json.loads(raw)
+    assert set(row) == sidecar.CONFIG_FIELDS
+    assert row["run_id"] == "family_seed_7_id_abcd1234__2026-08-27"
+    assert row["task"] == "task-a"
+    assert row["client"] == "qwen3-coder-flash"
+    assert row["generator_release"] == "qwen-release-2026-08"
+    assert row["hardware"] == "NVIDIA H200"
+    assert sidecar.validate_row(row) == row
+    assert sidecar.CREDENTIAL.search(raw) is None
+
+
+def test_prompt_changes_hash_but_run_paths_do_not() -> None:
+    base = resolved_config()
+    path_changed = copy.deepcopy(base)
+    path_changed["solver"]["exp_name"] = "another-run"
+    path_changed["solver"]["checkpoint_path"] = "/another/checkpoint"
+    prompt_changed = resolved_config(prompt="static policy v2")
+    base_row = sidecar.make_row(
+        base, generator_release="release-a", hardware="NVIDIA H200"
+    )
+    path_row = sidecar.make_row(
+        path_changed, generator_release="release-a", hardware="NVIDIA H200"
+    )
