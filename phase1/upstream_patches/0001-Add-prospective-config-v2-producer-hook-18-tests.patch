+def test_symlink_input_and_output_are_rejected(tmp_path: Path) -> None:
+    source = emit(tmp_path / "source", "family_seed_3_id_cccc3333")
+    input_link = tmp_path / "input-link.jsonl"
+    output_target = tmp_path / "output-target.jsonl"
+    output_target.write_text("keep\n", encoding="utf-8")
+    output_link = tmp_path / "output-link.jsonl"
+    try:
+        input_link.symlink_to(source)
+        output_link.symlink_to(output_target)
+    except OSError as exc:
+        pytest.skip(f"symlink creation unavailable: {exc}")
+    with pytest.raises(sidecar.SidecarError, match="symlinked"):
+        sidecar.collect_sidecars([input_link], output=tmp_path / "batch.jsonl")
+    with pytest.raises(sidecar.SidecarError, match="symlinked"):
+        sidecar.collect_sidecars([source], output=output_link)
+    assert output_target.read_text(encoding="utf-8") == "keep\n"
+
