+def test_competing_publisher_cannot_be_overwritten(tmp_path: Path, monkeypatch) -> None:
+    output = tmp_path / sidecar.PER_RUN_FILENAME
+    real_link = sidecar.os.link
+
+    def competing_link(source, destination):
+        Path(destination).write_bytes(b"competing publisher\n")
+        return real_link(source, destination)
+
+    monkeypatch.setattr(sidecar.os, "link", competing_link)
+    with pytest.raises(sidecar.SidecarError, match="appeared during atomic publish"):
+        sidecar.maybe_emit_for_resolved_run(
+            resolved_config(), output_dir=tmp_path, environ=enabled_env()
+        )
+    assert output.read_bytes() == b"competing publisher\n"
+    assert not list(tmp_path.glob("*.tmp-*"))
+
