index 0000000..7716d10
--- /dev/null
+++ b/src/mle_critic/src/preprocess/build_bt_pairs/verify_experiment_strata.py
@@ -0,0 +1,171 @@
+"""Independently verify exact experiment-stratum receipts for one batch."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import re
+import tempfile
+from pathlib import Path
+from typing import Any
+
+
+CREDENTIAL = re.compile(
+    rb"(?:^|[^A-Za-z0-9])(?:sk-[A-Za-z0-9._-]{16,}|hf_[A-Za-z0-9]{16,}|"
+    rb"gh[pousr]_[A-Za-z0-9]{16,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{30,}|"
+    rb"Bearer[ \t]+[A-Za-z0-9._-]{20,}|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----)"
+)
+SHA256 = re.compile(r"[0-9a-f]{64}")
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as input_file:
+        for chunk in iter(lambda: input_file.read(1 << 20), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def credential_free(path: Path) -> bool:
+    overlap = b""
+    with path.open("rb") as input_file:
+        for chunk in iter(lambda: input_file.read(1 << 20), b""):
+            window = overlap + chunk
+            if CREDENTIAL.search(window):
+                return False
+            overlap = window[-512:]
+    return True
+
+
+def config(card: dict[str, Any]) -> tuple[Any, ...]:
+    task = card.get("task")
+    if not isinstance(task, dict) or not isinstance(task.get("name"), str):
+        raise ValueError("Card task identity missing")
+    return (
+        task["name"],
+        card.get("client"),
+        card.get("hardware"),
+        card.get("time_limit"),
+        card.get("execution_timeout"),
+    )
+
+
+def stratum_sha256(card: dict[str, Any]) -> str:
+    payload = json.dumps(
+        config(card), ensure_ascii=False, separators=(",", ":"), allow_nan=False
+    )
+    return hashlib.sha256(payload.encode()).hexdigest()
+
+
+def verify(cards_path: Path, pairs_path: Path) -> dict[str, Any]:
+    if not credential_free(cards_path) or not credential_free(pairs_path):
+        raise ValueError("credential-shaped bytes refused before JSON parsing")
+    cards_payload = json.loads(cards_path.read_text(encoding="utf-8"))
+    if not isinstance(cards_payload, dict) or not cards_payload:
+        raise ValueError("Cards must be a nonempty run-grouped JSON object")
+    card_map: dict[str, dict[str, Any]] = {}
+    strata = set()
+    tasks = set()
+    for run_id, cards in cards_payload.items():
+        if not isinstance(run_id, str) or not isinstance(cards, list) or not cards:
+            raise ValueError("Physical run is invalid or empty")
+        run_configs = {config(card) for card in cards}
+        if len(run_configs) != 1:
+            raise ValueError(f"Physical run {run_id!r} mixes experiment configurations")
+        for card in cards:
+            card_id = card.get("id")
+            if not isinstance(card_id, str) or not card_id or card_id in card_map:
+                raise ValueError("Card identity missing or duplicated")
+            card_map[card_id] = card
+            strata.add(stratum_sha256(card))
+            tasks.add(config(card)[0])
+
+    cards_sha = sha256_file(cards_path)
+    pair_count = 0
+    pair_keys = set()
+    with pairs_path.open(encoding="utf-8") as input_file:
+        for line_number, line in enumerate(input_file, 1):
+            if not line.strip():
+                raise ValueError(f"Blank pair line {line_number}")
+            pair = json.loads(line)
+            endpoints = (pair.get("better"), pair.get("worse"))
+            if not all(isinstance(value, str) and value in card_map for value in endpoints):
+                raise ValueError(f"Unknown pair endpoint at line {line_number}")
+            if endpoints[0] == endpoints[1]:
+                raise ValueError(f"Self-pair at line {line_number}")
+            pair_key = tuple(sorted(endpoints))
+            if pair_key in pair_keys:
+                raise ValueError(f"Duplicate unordered pair at line {line_number}")
+            pair_keys.add(pair_key)
+            endpoint_strata = {stratum_sha256(card_map[value]) for value in endpoints}
+            if len(endpoint_strata) != 1:
+                raise ValueError(f"Cross-stratum pair at line {line_number}")
+            expected_stratum = endpoint_strata.pop()
+            if pair.get("experiment_stratum_sha256") != expected_stratum:
+                raise ValueError(f"Experiment-stratum receipt mismatch at line {line_number}")
+            if pair.get("batch_cards_sha256") != cards_sha:
+                raise ValueError(f"Batch provenance receipt mismatch at line {line_number}")
+            expected_task = config(card_map[endpoints[0]])[0]
+            if pair.get("task") != expected_task:
+                raise ValueError(f"Pair task mismatch at line {line_number}")
+            pair_count += 1
+
+    return {
+        "protocol": "exact-experiment-stratum-verifier-v1",
+        "status": "EXACT_EXPERIMENT_STRATUM_VERIFIED",
+        "cards_sha256": cards_sha,
+        "pairs_sha256": sha256_file(pairs_path),
+        "physical_runs": len(cards_payload),
+        "cards": len(card_map),
+        "pairs": pair_count,
+        "tasks": len(tasks),
+        "experiment_strata": len(strata),
+        "numeric_grade_used": False,
+        "raw_config_emitted": False,
+    }
+
+
+def write_receipt(path: Path, receipt: dict[str, Any]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary_path = None
+    try:
+        with tempfile.NamedTemporaryFile(
+            mode="w", encoding="utf-8", dir=path.parent,
+            prefix=f".{path.name}.", suffix=".tmp", delete=False,
+        ) as output_file:
+            temporary_path = Path(output_file.name)
+            json.dump(receipt, output_file, indent=2, sort_keys=True)
+            output_file.write("\n")
+        os.replace(temporary_path, path)
+    finally:
+        if temporary_path is not None and temporary_path.exists():
+            temporary_path.unlink()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest="command", required=True)
+    scan_parser = commands.add_parser(
+        "scan", help="credential-scan Cards before producer parsing"
+    )
+    scan_parser.add_argument("cards", type=Path)
+    verify_parser = commands.add_parser(
+        "verify", help="verify one batch and write its receipt"
+    )
+    verify_parser.add_argument("receipt", type=Path)
+    verify_parser.add_argument("cards", type=Path)
+    verify_parser.add_argument("pairs", type=Path)
+    arguments = parser.parse_args()
+    if arguments.command == "scan":
+        if not credential_free(arguments.cards):
+            raise ValueError("credential-shaped bytes refused before producer parsing")
+        print("EXPERIMENT_STRATUM_CREDENTIAL_SCAN_PASS")
+        return
+    receipt = verify(arguments.cards, arguments.pairs)
+    write_receipt(arguments.receipt, receipt)
+    print(json.dumps(receipt, sort_keys=True, separators=(",", ":")))
+
+
+if __name__ == "__main__":
+    main()
