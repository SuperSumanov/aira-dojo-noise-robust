 from collections.abc import Callable, Iterable, Sequence
 from pathlib import Path
 from typing import Any
@@ -15,6 +22,91 @@ import torch
 
 EncodeCard = Callable[[str, int | None], list[int]]
 
+ONE_SHOT_PROTOCOL = "rm-one-shot-test-v1"
+_SHA256_PATTERN = re.compile(r"[0-9a-f]{64}")
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as input_file:
+        for chunk in iter(lambda: input_file.read(1 << 20), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _write_json_exclusive(path: Path, payload: dict[str, Any]) -> None:
+    rendered = json.dumps(
+        payload, indent=2, sort_keys=True, allow_nan=False
+    ) + "\n"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("x", encoding="utf-8") as output_file:
+        output_file.write(rendered)
+
+
+def _replace_json(path: Path, payload: dict[str, Any]) -> None:
+    rendered = json.dumps(
+        payload, indent=2, sort_keys=True, allow_nan=False
+    ) + "\n"
+    temporary_path: Path | None = None
+    try:
+        with tempfile.NamedTemporaryFile(
+            mode="w", encoding="utf-8", dir=path.parent,
+            prefix=f".{path.name}.", suffix=".tmp", delete=False,
+        ) as output_file:
+            temporary_path = Path(output_file.name)
+            output_file.write(rendered)
+        os.replace(temporary_path, path)
+    finally:
+        if temporary_path is not None and temporary_path.exists():
+            temporary_path.unlink()
+
+
+def normalize_expected_sha256(value: str, label: str) -> str:
+    """Validate an externally committed SHA-256 before touching frozen data."""
+    normalized = value.strip().lower()
+    if not _SHA256_PATTERN.fullmatch(normalized):
+        raise ValueError(f"{label} must be exactly 64 hexadecimal characters")
+    return normalized
+
+
+def verify_expected_sha256(path: Path, expected: str, label: str) -> str:
+    """Fail closed when an immutable input is absent or differs from its receipt."""
+    if not path.is_file():
+        raise FileNotFoundError(f"{label} is missing: {path}")
+    expected = normalize_expected_sha256(expected, label)
+    actual = sha256_file(path)
+    if actual != expected:
+        raise ValueError(
+            f"{label} SHA-256 mismatch: expected {expected}, observed {actual}"
+        )
+    return actual
+
+
+def claim_one_shot_test(
+    ledger_path: Path,
+    *,
+    output_path: Path,
+    expected_artifacts: dict[str, str],
+    invocation: dict[str, Any],
+) -> dict[str, Any]:
+    """Exclusively consume a frozen-test attempt before the pair file is opened."""
+    if ledger_path.resolve() == output_path.resolve():
+        raise ValueError("one-shot ledger and evaluation output must be different files")
+    if output_path.exists():
+        raise FileExistsError(f"refusing to overwrite evaluation output: {output_path}")
+    payload: dict[str, Any] = {
+        "protocol": ONE_SHOT_PROTOCOL,
+        "status": "STARTED",
+        "started_at_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
+        "host": socket.gethostname(),
+        "pid": os.getpid(),
+        "output": str(output_path.resolve()),
+        "expected_artifacts": expected_artifacts,
+        "invocation": invocation,
+    }
+    _write_json_exclusive(ledger_path, payload)
+    return payload
+
 
 class _RewardModel(torch.nn.Module):
     """Backbone plus the scalar head used by bradley_terry.py."""
