@@ -0,0 +1,282 @@
+"""Independently verify a physical-run train/dev split and its immutable manifest."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from collections import Counter, defaultdict
+from pathlib import Path
+from typing import Any
+
+from .verify_experiment_strata import credential_free, sha256_file
+
+
+PROTOCOL = "physical-run-train-dev-split-v1"
+
+
+def _canonical(value: Any) -> str:
+    return json.dumps(
+        value, ensure_ascii=False, sort_keys=True, separators=(",", ":"),
+        allow_nan=False,
+    )
+
+
+def _config(card: dict[str, Any]) -> tuple[Any, ...]:
+    task = card.get("task")
+    if not isinstance(task, dict) or not isinstance(task.get("name"), str):
+        raise ValueError("Card task identity missing")
+    return (
+        task["name"], card.get("client"), card.get("hardware"),
+        card.get("time_limit"), card.get("execution_timeout"),
+    )
+
+
+def _key(pair: dict[str, Any]) -> tuple[str, str, Any]:
+    better = pair.get("better")
+    worse = pair.get("worse")
+    if not isinstance(better, str) or not isinstance(worse, str) or better == worse:
+        raise ValueError("Pair endpoints are invalid")
+    return (*sorted((better, worse)), pair.get("budget"))
+
+
+def _read_jsonl(path: Path) -> list[dict[str, Any]]:
+    if not credential_free(path):
+        raise ValueError(f"credential-shaped bytes refused before parsing {path}")
+    records = []
+    with path.open(encoding="utf-8") as input_file:
+        for line_number, line in enumerate(input_file, 1):
+            if not line.strip():
+                raise ValueError(f"Blank line at {path}:{line_number}")
+            record = json.loads(line)
+            if not isinstance(record, dict):
+                raise ValueError(f"Non-object record at {path}:{line_number}")
+            records.append(record)
+    return records
+
+
+def verify(
+    cards_path: Path,
+    source_pairs_path: Path,
+    train_path: Path,
+    dev_path: Path,
+    manifest_path: Path,
+    frozen_test_path: Path | None = None,
+) -> dict[str, Any]:
+    checked_paths = [cards_path, source_pairs_path, train_path, dev_path, manifest_path]
+    if frozen_test_path is not None:
+        checked_paths.append(frozen_test_path)
+    for path in checked_paths:
+        if not credential_free(path):
+            raise ValueError(f"credential-shaped bytes refused before parsing {path}")
+
+    cards_payload = json.loads(cards_path.read_text(encoding="utf-8"))
+    if not isinstance(cards_payload, dict) or not cards_payload:
+        raise ValueError("Cards must be a nonempty grouped object")
+    run_by_card: dict[str, str] = {}
+    task_by_run: dict[str, str] = {}
+    config_by_card: dict[str, tuple[Any, ...]] = {}
+    for run_id, cards in cards_payload.items():
+        if not isinstance(run_id, str) or not isinstance(cards, list) or not cards:
+            raise ValueError("Invalid physical run")
+        configs = {_config(card) for card in cards}
+        if len(configs) != 1:
+            raise ValueError(f"Run {run_id!r} mixes experiment strata")
+        task_by_run[run_id] = next(iter(configs))[0]
+        for card in cards:
+            card_id = card.get("id")
+            if not isinstance(card_id, str) or not card_id or card_id in run_by_card:
+                raise ValueError("Card identity missing or duplicated")
+            run_by_card[card_id] = run_id
+            config_by_card[card_id] = _config(card)
+
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    if manifest.get("protocol") != PROTOCOL:
+        raise ValueError("Manifest protocol mismatch")
+    seed = manifest.get("seed")
+    dev_fraction = manifest.get("dev_fraction")
+    if not isinstance(seed, int) or not isinstance(dev_fraction, (int, float)):
+        raise ValueError("Manifest split parameters are invalid")
+    if not 0.0 < float(dev_fraction) < 0.5:
+        raise ValueError("Manifest dev fraction is invalid")
+
+    source_records = _read_jsonl(source_pairs_path)
+    source_train: dict[tuple[str, str, Any], dict[str, Any]] = {}
+    source_test: dict[tuple[str, str, Any], dict[str, Any]] = {}
+    source_seen: set[tuple[str, str, Any]] = set()
+    source_counts: Counter[str] = Counter()
+    runs_by_task: dict[str, set[str]] = defaultdict(set)
+    for pair in source_records:
+        split = pair.get("intask_split")
+        source_counts[f"outer_{split}"] += 1
+        if split not in {"train", "test"}:
+            raise ValueError(f"Unsupported outer split {split!r}")
+        key = _key(pair)
+        if key in source_seen:
+            raise ValueError("Duplicate source unordered pair")
+        source_seen.add(key)
+        endpoints = (pair["better"], pair["worse"])
+        if any(endpoint not in run_by_card for endpoint in endpoints):
+            raise ValueError("Source pair references an unknown Card")
+        if config_by_card[endpoints[0]] != config_by_card[endpoints[1]]:
+            raise ValueError("Source train pair crosses experiment strata")
+        endpoint_runs = [run_by_card[endpoint] for endpoint in endpoints]
+        tasks = {task_by_run[run_id] for run_id in endpoint_runs}
+        if len(tasks) != 1 or pair.get("task") not in tasks:
+            raise ValueError("Source pair task mismatch")
+        if split == "train":
+            source_train[key] = pair
+            for run_id in endpoint_runs:
+                runs_by_task[task_by_run[run_id]].add(run_id)
+        else:
+            source_test[key] = pair
+
+    if source_test and frozen_test_path is None:
+        raise ValueError("Combined source requires a dedicated frozen-test file")
+    if not source_test and frozen_test_path is not None:
+        raise ValueError("Frozen-test file supplied but source contains no test rows")
+
+    selected_dev_runs: set[str] = set()
+    for task_name in sorted(runs_by_task):
+        task_runs = sorted(
+            runs_by_task[task_name],
+            key=lambda run_id: (
+                hashlib.sha256(_canonical([seed, task_name, run_id]).encode()).hexdigest(),
+                run_id,
+            ),
+        )
+        if len(task_runs) < 2:
+            continue
+        count = min(len(task_runs) - 1, max(1, round(len(task_runs) * float(dev_fraction))))
+        selected_dev_runs.update(task_runs[:count])
+
+    outputs: dict[str, dict[tuple[str, str, Any], dict[str, Any]]] = {}
+    for split, path in (("train", train_path), ("dev", dev_path)):
+        split_records: dict[tuple[str, str, Any], dict[str, Any]] = {}
+        for pair in _read_jsonl(path):
+            if pair.get("intask_split") != split:
+                raise ValueError(f"{split} output contains another split")
+            if pair.get("outer_intask_split") != "train":
+                raise ValueError("Output contains a non-train outer identity")
+            if pair.get("train_dev_protocol") != PROTOCOL or pair.get("train_dev_seed") != seed:
+                raise ValueError("Output train/dev receipt mismatch")
+            key = _key(pair)
+            if key in split_records:
+                raise ValueError(f"Duplicate pair in {split} output")
+            split_records[key] = pair
+        outputs[split] = split_records
+
+    expected: dict[str, set[tuple[str, str, Any]]] = {"train": set(), "dev": set()}
+    dropped = 0
+    for key, pair in source_train.items():
+        endpoint_runs = {run_by_card[pair["better"]], run_by_card[pair["worse"]]}
+        endpoint_is_dev = {run_id in selected_dev_runs for run_id in endpoint_runs}
+        if len(endpoint_is_dev) != 1:
+            dropped += 1
+            continue
+        split = "dev" if endpoint_is_dev.pop() else "train"
+        expected[split].add(key)
+    for split in ("train", "dev"):
+        if set(outputs[split]) != expected[split]:
+            raise ValueError(f"{split} output does not equal deterministic assignment")
+        for key, output_pair in outputs[split].items():
+            recovered = dict(output_pair)
+            recovered.pop("outer_intask_split")
+            recovered.pop("train_dev_protocol")
+            recovered.pop("train_dev_seed")
+            recovered["intask_split"] = "train"
+            if recovered != source_train[key]:
+                raise ValueError(f"{split} output changed source pair content")
+
+    train_runs = {
+        run_by_card[endpoint]
+        for pair in outputs["train"].values()
+        for endpoint in (pair["better"], pair["worse"])
+    }
+    dev_runs = {
+        run_by_card[endpoint]
+        for pair in outputs["dev"].values()
+        for endpoint in (pair["better"], pair["worse"])
+    }
+    if train_runs & dev_runs:
+        raise ValueError("Train/dev physical-run overlap")
+
+    frozen_test_records: dict[tuple[str, str, Any], dict[str, Any]] = {}
+    if frozen_test_path is not None:
+        for pair in _read_jsonl(frozen_test_path):
+            if pair.get("intask_split") != "test":
+                raise ValueError("Frozen-test output contains another split")
+            key = _key(pair)
+            if key in frozen_test_records:
+                raise ValueError("Duplicate pair in frozen-test output")
+            frozen_test_records[key] = pair
+        if frozen_test_records != source_test:
+            raise ValueError("Frozen-test output differs from source test rows")
+
+    outer_train_endpoints = {
+        endpoint
+        for pair in source_train.values()
+        for endpoint in (pair["better"], pair["worse"])
+    }
+    outer_test_endpoints = {
+        endpoint
+        for pair in frozen_test_records.values()
+        for endpoint in (pair["better"], pair["worse"])
+    }
+    if outer_train_endpoints & outer_test_endpoints:
+        raise ValueError("Outer train/test Card overlap")
+    outer_train_runs = {run_by_card[card_id] for card_id in outer_train_endpoints}
+    outer_test_runs = {run_by_card[card_id] for card_id in outer_test_endpoints}
+    if outer_train_runs & outer_test_runs:
+        raise ValueError("Outer train/test physical-run overlap")
+
+    expected_manifest = {
+        "cards_sha256": sha256_file(cards_path),
+        "source_pairs_sha256": sha256_file(source_pairs_path),
+        "train_pairs_sha256": sha256_file(train_path),
+        "dev_pairs_sha256": sha256_file(dev_path),
+        "source_counts": dict(sorted(source_counts.items())),
+        "train_pairs": len(outputs["train"]),
+        "dev_pairs": len(outputs["dev"]),
+        "dropped_cross_split_pairs": dropped,
+        "train_runs": len(train_runs),
+        "dev_runs": len(dev_runs),
+        "run_overlap": 0,
+        "outer_test_rows_emitted": 0,
+        "frozen_test_pairs": len(frozen_test_records),
+        "frozen_test_pairs_sha256": (
+            sha256_file(frozen_test_path) if frozen_test_path is not None else None
+        ),
+        "outer_train_test_card_overlap": 0,
+        "outer_train_test_run_overlap": 0,
+        "train_run_ids_sha256": hashlib.sha256(_canonical(sorted(train_runs)).encode()).hexdigest(),
+        "dev_run_ids_sha256": hashlib.sha256(_canonical(sorted(dev_runs)).encode()).hexdigest(),
+    }
+    for field, value in expected_manifest.items():
+        if manifest.get(field) != value:
+            raise ValueError(f"Manifest mismatch for {field}")
+
+    return {
+        "protocol": "physical-run-train-dev-verifier-v1",
+        "status": "TRAIN_DEV_SPLIT_INDEPENDENTLY_VERIFIED",
+        **expected_manifest,
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("cards", type=Path)
+    parser.add_argument("source_pairs", type=Path)
+    parser.add_argument("train_pairs", type=Path)
+    parser.add_argument("dev_pairs", type=Path)
+    parser.add_argument("manifest", type=Path)
+    parser.add_argument("--frozen-test", type=Path)
+    arguments = parser.parse_args()
+    receipt = verify(
+        arguments.cards, arguments.source_pairs, arguments.train_pairs,
+        arguments.dev_pairs, arguments.manifest, arguments.frozen_test,
+    )
+    print(_canonical(receipt))
+
+
+if __name__ == "__main__":
+    main()
