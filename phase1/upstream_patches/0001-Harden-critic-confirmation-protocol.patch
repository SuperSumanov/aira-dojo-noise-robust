+import hashlib
+import json
+
+import pytest
+
+from src.mle_critic.src.evaluation.bradley_terry_evaluation import (
+    ONE_SHOT_PROTOCOL,
+    claim_one_shot_test,
+    normalize_expected_sha256,
+    pair_prediction_records,
+    read_evaluation_pairs,
+    verify_expected_sha256,
+)
+
+
+def test_sha256_receipt_is_strict(tmp_path):
+    artifact = tmp_path / "artifact.bin"
+    artifact.write_bytes(b"frozen")
+    expected = hashlib.sha256(b"frozen").hexdigest()
+
+    assert normalize_expected_sha256(expected.upper(), "artifact") == expected
+    assert verify_expected_sha256(artifact, expected, "artifact") == expected
+    with pytest.raises(ValueError, match="mismatch"):
+        verify_expected_sha256(artifact, "0" * 64, "artifact")
+    with pytest.raises(ValueError, match="64 hexadecimal"):
+        normalize_expected_sha256("not-a-hash", "artifact")
+
+
+def test_one_shot_ledger_is_exclusive_and_does_not_overwrite_output(tmp_path):
+    ledger_path = tmp_path / "attempt.json"
+    output_path = tmp_path / "result.json"
+    payload = claim_one_shot_test(
+        ledger_path,
+        output_path=output_path,
+        expected_artifacts={"pairs": "a" * 64},
+        invocation={"split": "test"},
+    )
+
+    assert payload["protocol"] == ONE_SHOT_PROTOCOL
+    assert payload["status"] == "STARTED"
+    assert json.loads(ledger_path.read_text())["status"] == "STARTED"
+    with pytest.raises(FileExistsError):
+        claim_one_shot_test(
+            ledger_path,
+            output_path=output_path,
+            expected_artifacts={"pairs": "a" * 64},
+            invocation={"split": "test"},
+        )
+
+    second_ledger = tmp_path / "attempt-2.json"
+    output_path.write_text("already exists")
+    with pytest.raises(FileExistsError, match="overwrite"):
+        claim_one_shot_test(
+            second_ledger,
+            output_path=output_path,
+            expected_artifacts={"pairs": "a" * 64},
+            invocation={"split": "test"},
+        )
+    assert not second_ledger.exists()
+
+
+def test_dedicated_test_pool_and_pair_level_receipt(tmp_path):
+    pairs_path = tmp_path / "test.jsonl"
+    pair = {
+        "better": "a",
+        "worse": "b",
+        "task": "task-a",
+        "intask_split": "test",
+        "parent": "p",
+        "pair_semantics": "canonical_raw_sibling",
+        "endpoint_run_ids": ["run-1", "run-1"],
+    }
+    pairs_path.write_text(json.dumps(pair) + "\n")
+    cards = {"a": "code-a", "b": "code-b"}
+    tasks = {"a": "task-a", "b": "task-a"}
+    runs = {"a": "run-1", "b": "run-1"}
+
+    pairs = read_evaluation_pairs(
+        pairs_path,
+        expected_split="test",
+        cards=cards,
+        card_tasks=tasks,
+        card_runs=runs,
+    )
+    receipts = pair_prediction_records(pairs, [0.25], runs)
+
+    assert receipts == [
+        {
+            "pair_index": 0,
+            "task": "task-a",
+            "better": "a",
+            "worse": "b",
+            "endpoint_run_ids": ["run-1", "run-1"],
+            "margin": 0.25,
+            "correct": True,
+            "parent": "p",
+            "pair_semantics": "canonical_raw_sibling",
+        }
+    ]
+
+
+def test_test_reader_rejects_mixed_split_and_bad_run_receipt(tmp_path):
+    pairs_path = tmp_path / "mixed.jsonl"
+    cards = {"a": "code-a", "b": "code-b"}
+    tasks = {"a": "task-a", "b": "task-a"}
+    runs = {"a": "run-1", "b": "run-2"}
+    pair = {
+        "better": "a",
+        "worse": "b",
+        "task": "task-a",
+        "intask_split": "train",
+    }
+    pairs_path.write_text(json.dumps(pair) + "\n")
+    with pytest.raises(ValueError, match="dedicated 'test' file"):
+        read_evaluation_pairs(
