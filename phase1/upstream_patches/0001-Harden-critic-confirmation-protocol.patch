+def read_pairs_for_split(
+    path: str,
+    code: dict[str, str],
+    expected_split: str,
+) -> list[dict[str, Any]]:
+    """Strictly read one split without silently dropping or accepting other rows."""
+    if expected_split not in {"train", "dev", "test"}:
+        raise ValueError(f"Unsupported expected split: {expected_split!r}")
+
+    records: list[dict[str, Any]] = []
+    unordered_pairs: set[tuple[str, str, Any]] = set()
+    with Path(path).open(encoding="utf-8") as input_file:
+        for line_number, line in enumerate(input_file, 1):
+            if not line.strip():
+                raise ValueError(f"Blank pair line at {path}:{line_number}")
+            try:
+                pair = json.loads(line)
+            except json.JSONDecodeError as error:
+                raise ValueError(f"Invalid JSON at {path}:{line_number}") from error
+            if not isinstance(pair, dict):
+                raise ValueError(f"Pair is not an object at {path}:{line_number}")
+            if pair.get("intask_split") != expected_split:
+                raise ValueError(
+                    f"Expected only {expected_split!r} rows at {path}:{line_number}; "
+                    f"found {pair.get('intask_split')!r}"
+                )
+            better = pair.get("better")
+            worse = pair.get("worse")
+            if not isinstance(better, str) or not isinstance(worse, str):
+                raise ValueError(f"Pair endpoints are invalid at {path}:{line_number}")
+            if better == worse:
+                raise ValueError(f"Self-pair at {path}:{line_number}")
+            missing = [card_id for card_id in (better, worse) if card_id not in code]
+            if missing:
+                raise ValueError(
+                    f"Unknown Card IDs at {path}:{line_number}: {sorted(missing)}"
+                )
+            pair_key = (*sorted((better, worse)), pair.get("budget"))
+            if pair_key in unordered_pairs:
+                raise ValueError(f"Duplicate unordered pair at {path}:{line_number}")
+            unordered_pairs.add(pair_key)
+            records.append(pair)
+    if not records:
+        raise ValueError(f"No {expected_split!r} pairs found in {path}")
+    return records
+
+
+def validate_disjoint_pair_pools(
+    training_records: Sequence[dict[str, Any]],
+    validation_records: Sequence[dict[str, Any]],
+    run_id_by_card_id: dict[str, str],
+) -> dict[str, int]:
+    """Fail closed unless train and dev are disjoint by pair, Card, and run."""
+
+    def endpoints(records: Sequence[dict[str, Any]]) -> set[str]:
+        return {
+            card_id
+            for pair in records
+            for card_id in (pair["better"], pair["worse"])
+        }
+
+    def pair_keys(records: Sequence[dict[str, Any]]) -> set[tuple[str, str, Any]]:
+        return {
+            (*sorted((pair["better"], pair["worse"])), pair.get("budget"))
+            for pair in records
+        }
+
+    train_endpoints = endpoints(training_records)
+    dev_endpoints = endpoints(validation_records)
+    endpoint_overlap = train_endpoints & dev_endpoints
+    if endpoint_overlap:
+        raise ValueError(
+            f"Train/dev Card overlap is forbidden: {len(endpoint_overlap)} endpoints"
+        )
+
+    train_runs = {run_id_by_card_id[card_id] for card_id in train_endpoints}
+    dev_runs = {run_id_by_card_id[card_id] for card_id in dev_endpoints}
+    run_overlap = train_runs & dev_runs
+    if run_overlap:
+        raise ValueError(
+            f"Train/dev physical-run overlap is forbidden: {len(run_overlap)} runs"
+        )
+
+    duplicate_pairs = pair_keys(training_records) & pair_keys(validation_records)
+    if duplicate_pairs:
+        raise ValueError(
+            f"Train/dev unordered-pair overlap is forbidden: {len(duplicate_pairs)} pairs"
+        )
+
+    return {
+        "train_pairs": len(training_records),
+        "dev_pairs": len(validation_records),
+        "train_endpoints": len(train_endpoints),
+        "dev_endpoints": len(dev_endpoints),
+        "train_runs": len(train_runs),
+        "dev_runs": len(dev_runs),
+    }
+
