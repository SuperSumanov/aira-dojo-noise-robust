+    card_tasks: dict[str, str],
+    card_runs: dict[str, str],
+) -> list[dict[str, Any]]:
+    """Read an evaluation pool without silently skipping malformed observations."""
+    if expected_split not in {"all", "train", "dev", "test"}:
+        raise ValueError(f"unsupported evaluation split: {expected_split!r}")
+
+    pairs: list[dict[str, Any]] = []
+    unordered_pairs: set[tuple[str, str, Any]] = set()
+    with path.open(encoding="utf-8") as input_file:
