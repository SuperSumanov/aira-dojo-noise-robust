+            *paths[:5],
+            seed=7,
+            dev_fraction=0.25,
+            curator_allow_filter_outer_test=False,
+        )
+
+
+def test_verifier_rejects_tampered_dev_receipt(tmp_path):
+    paths = _fixture(tmp_path)
+    build_split(
+        *paths,
+        seed=7,
+        dev_fraction=0.25,
+        curator_allow_filter_outer_test=True,
+    )
+    records = [json.loads(line) for line in paths[3].read_text().splitlines()]
+    records[0]["train_dev_seed"] = 8
+    paths[3].write_text(
+        "".join(json.dumps(record, sort_keys=True) + "\n" for record in records),
+        encoding="utf-8",
+    )
+
+    with pytest.raises(ValueError, match="receipt mismatch"):
+        verify(*paths)
+
+
+def test_verifier_rejects_tampered_frozen_test(tmp_path):
+    paths = _fixture(tmp_path)
+    build_split(
+        *paths,
+        seed=7,
+        dev_fraction=0.25,
+        curator_allow_filter_outer_test=True,
+    )
+    record = json.loads(paths[5].read_text().strip())
+    record["gap_raw"] = 999.0
+    paths[5].write_text(json.dumps(record) + "\n", encoding="utf-8")
+
+    with pytest.raises(ValueError, match="Frozen-test output"):
+        verify(*paths)
