+        "id": card_id,
+        "task": {"name": task},
+        "client": "qwen",
+        "hardware": "pro6000",
+        "time_limit": 7200,
+        "execution_timeout": 1200,
+        "code": f"print({card_id!r})",
+    }
+
+
+def _fixture(tmp_path):
+    cards_path = tmp_path / "cards.json"
+    pairs_path = tmp_path / "pairs.jsonl"
+    train_path = tmp_path / "train.jsonl"
+    dev_path = tmp_path / "dev.jsonl"
+    manifest_path = tmp_path / "manifest.json"
+    frozen_test_path = tmp_path / "frozen-test.jsonl"
+    cards = {}
+    pairs = []
+    for index in range(4):
+        run_id = f"run-{index}"
+        left, right = f"c{index}a", f"c{index}b"
+        cards[run_id] = [_card(left), _card(right)]
+        pairs.append(
+            {
+                "task": "task",
+                "better": left,
+                "worse": right,
+                "gap_raw": 0.1 + index,
+                "intask_split": "train",
+            }
+        )
+    cards["outer-test"] = [_card("test-a"), _card("test-b")]
+    pairs.append(
+        {
+            "task": "task",
+            "better": "test-a",
+            "worse": "test-b",
+            "gap_raw": 1.0,
+            "intask_split": "test",
+        }
+    )
+    cards_path.write_text(json.dumps(cards), encoding="utf-8")
+    pairs_path.write_text(
+        "".join(json.dumps(pair) + "\n" for pair in pairs), encoding="utf-8"
+    )
+    return (
+        cards_path,
+        pairs_path,
+        train_path,
+        dev_path,
+        manifest_path,
+        frozen_test_path,
+    )
+
+
+def test_train_dev_split_is_run_disjoint_and_independently_verified(tmp_path):
+    paths = _fixture(tmp_path)
+    manifest = build_split(
+        *paths,
+        seed=7,
+        dev_fraction=0.25,
+        curator_allow_filter_outer_test=True,
+    )
+
+    assert manifest["train_pairs"] == 3
+    assert manifest["dev_pairs"] == 1
+    assert manifest["source_counts"] == {"outer_test": 1, "outer_train": 4}
+    assert manifest["outer_test_rows_emitted"] == 0
+    assert manifest["frozen_test_pairs"] == 1
+    assert all(
+        json.loads(line)["intask_split"] == "train"
+        for line in paths[2].read_text().splitlines()
+    )
+    assert all(
+        json.loads(line)["intask_split"] == "dev"
+        for line in paths[3].read_text().splitlines()
+    )
+
+    assert [
+        json.loads(line)["intask_split"]
+        for line in paths[5].read_text().splitlines()
+    ] == ["test"]
+
+    receipt = verify(*paths)
+    assert receipt["status"] == "TRAIN_DEV_SPLIT_INDEPENDENTLY_VERIFIED"
+    assert receipt["run_overlap"] == 0
+
+
+def test_combined_outer_file_requires_explicit_curator_mode(tmp_path):
+    paths = _fixture(tmp_path)
+    with pytest.raises(ValueError, match="trusted migration"):
