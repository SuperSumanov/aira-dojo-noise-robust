+import json
+from pathlib import Path
+
+import pytest
+
+from src.mle_critic.src.preprocess.build_bt_pairs.build_subtree_pairs import (
+    build_value_pairs,
+)
+from src.mle_critic.src.preprocess.build_bt_pairs.verify_experiment_strata import (
+    sha256_file,
+    verify,
+)
+from src.mle_critic.src.preprocess.download_and_resolve.cards import save_cards
+from src.mle_critic.test.test_build_subtree_pairs import make_card
+
+
+def build_fixture(tmp_path: Path):
+    cards_path = tmp_path / "batch_cards.json"
+    pairs_path = tmp_path / "batch_value_pairs.jsonl"
+    cards_by_run = {
+        "run-a": [make_card("a", 0.1), make_card("a-child", 0.9, "a")],
+        "run-b": [make_card("b", 0.8), make_card("b-child", 0.8, "b")],
+    }
+    save_cards(cards_by_run, str(cards_path))
+    pairs, _ = build_value_pairs(
+        cards_by_run, batch_cards_sha256=sha256_file(cards_path)
+    )
+    pairs_path.write_text(
+        "".join(json.dumps(pair) + "\n" for pair in pairs), encoding="utf-8"
+    )
+    return cards_path, pairs_path
+
+
+def test_independent_stratum_verifier_accepts_receipts(tmp_path: Path):
+    cards_path, pairs_path = build_fixture(tmp_path)
+
+    receipt = verify(cards_path, pairs_path)
+
+    assert receipt["status"] == "EXACT_EXPERIMENT_STRATUM_VERIFIED"
+    assert receipt["pairs"] > 0
+    assert receipt["experiment_strata"] == 1
+
+
+def test_independent_stratum_verifier_rejects_tampered_receipt(tmp_path: Path):
+    cards_path, pairs_path = build_fixture(tmp_path)
+    rows = [json.loads(line) for line in pairs_path.read_text().splitlines()]
+    rows[0]["experiment_stratum_sha256"] = "f" * 64
+    pairs_path.write_text(
+        "".join(json.dumps(pair) + "\n" for pair in rows), encoding="utf-8"
+    )
+
+    with pytest.raises(ValueError, match="receipt mismatch"):
+        verify(cards_path, pairs_path)
+
+
+def test_credential_scan_refuses_before_json_parsing(tmp_path: Path):
+    cards_path = tmp_path / "unsafe_cards.json"
+    pairs_path = tmp_path / "pairs.jsonl"
+    cards_path.write_text("sk-" + "A" * 32, encoding="utf-8")
+    pairs_path.write_text("not-json\n", encoding="utf-8")
+
+    with pytest.raises(ValueError, match="credential-shaped bytes refused"):
+        verify(cards_path, pairs_path)
