+++ b/src/mle_critic/src/preprocess/build_bt_pairs/build_train_dev_split.py
@@ -0,0 +1,368 @@
+"""Derive a physical-run-disjoint dev split from the outer training runs only.
+
+The normal mode refuses any non-train row in the input pair file. A trusted data
+curator may explicitly pass ``--curator-allow-filter-outer-test`` when migrating a
+legacy combined train/test file, but must then materialize a dedicated immutable
+frozen-test file. Training receives only the two outer-train-derived outputs.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import tempfile
+from collections import Counter, defaultdict
+from pathlib import Path
+from typing import Any, Iterable
+
+from .verify_experiment_strata import credential_free, sha256_file
+
+
+PROTOCOL = "physical-run-train-dev-split-v1"
+
+
+def canonical_json(value: Any) -> str:
+    return json.dumps(
+        value, ensure_ascii=False, sort_keys=True, separators=(",", ":"),
+        allow_nan=False,
+    )
+
+
+def _card_config(card: dict[str, Any]) -> tuple[Any, ...]:
+    task = card.get("task")
+    if not isinstance(task, dict) or not isinstance(task.get("name"), str):
+        raise ValueError("Card task identity missing")
+    return (
+        task["name"],
+        card.get("client"),
+        card.get("hardware"),
+        card.get("time_limit"),
+        card.get("execution_timeout"),
+    )
+
+
+def index_cards(
+    cards_path: Path,
+) -> tuple[dict[str, str], dict[str, str], dict[str, tuple[Any, ...]]]:
+    if not credential_free(cards_path):
+        raise ValueError("credential-shaped bytes refused before Cards parsing")
+    payload = json.loads(cards_path.read_text(encoding="utf-8"))
+    if not isinstance(payload, dict) or not payload:
+        raise ValueError("Cards must be a nonempty run-grouped JSON object")
+
+    run_by_card: dict[str, str] = {}
+    task_by_run: dict[str, str] = {}
+    config_by_card: dict[str, tuple[Any, ...]] = {}
+    for run_id, run_cards in payload.items():
+        if not isinstance(run_id, str) or not run_id:
+            raise ValueError("Invalid physical run ID")
+        if not isinstance(run_cards, list) or not run_cards:
+            raise ValueError(f"Physical run {run_id!r} has no Cards")
+        run_configs = {_card_config(card) for card in run_cards}
+        if len(run_configs) != 1:
+            raise ValueError(f"Physical run {run_id!r} mixes experiment strata")
+        task_name = next(iter(run_configs))[0]
+        task_by_run[run_id] = task_name
+        for card in run_cards:
+            card_id = card.get("id")
+            if not isinstance(card_id, str) or not card_id or card_id in run_by_card:
+                raise ValueError("Card identity is missing or duplicated")
+            run_by_card[card_id] = run_id
+            config_by_card[card_id] = _card_config(card)
+    return run_by_card, task_by_run, config_by_card
+
+
+def _pair_key(pair: dict[str, Any]) -> tuple[str, str, Any]:
+    return (*sorted((pair["better"], pair["worse"])), pair.get("budget"))
+
+
+def read_outer_train_pairs(
+    pairs_path: Path,
+    run_by_card: dict[str, str],
+    task_by_run: dict[str, str],
+    config_by_card: dict[str, tuple[Any, ...]],
+    *,
+    curator_allow_filter_outer_test: bool,
+) -> tuple[list[dict[str, Any]], list[dict[str, Any]], Counter[str]]:
+    if not credential_free(pairs_path):
+        raise ValueError("credential-shaped bytes refused before pair parsing")
+    records: list[dict[str, Any]] = []
+    frozen_test_records: list[dict[str, Any]] = []
+    counts: Counter[str] = Counter()
+    seen: set[tuple[str, str, Any]] = set()
+    with pairs_path.open(encoding="utf-8") as input_file:
+        for line_number, line in enumerate(input_file, 1):
+            if not line.strip():
+                raise ValueError(f"Blank pair line {line_number}")
+            pair = json.loads(line)
+            if not isinstance(pair, dict):
+                raise ValueError(f"Pair line {line_number} is not an object")
+            outer_split = pair.get("intask_split")
+            better = pair.get("better")
+            worse = pair.get("worse")
+            if not isinstance(better, str) or not isinstance(worse, str) or better == worse:
+                raise ValueError(f"Invalid pair endpoints at line {line_number}")
+            missing = [value for value in (better, worse) if value not in run_by_card]
+            if missing:
+                raise ValueError(f"Unknown Card IDs at line {line_number}: {missing}")
+            endpoint_runs = (run_by_card[better], run_by_card[worse])
+            endpoint_tasks = {task_by_run[run_id] for run_id in endpoint_runs}
+            if len(endpoint_tasks) != 1 or pair.get("task") not in endpoint_tasks:
+                raise ValueError(f"Pair task mismatch at line {line_number}")
+            if config_by_card[better] != config_by_card[worse]:
+                raise ValueError(f"Cross-experiment-stratum pair at line {line_number}")
+            key = _pair_key(pair)
+            if key in seen:
+                raise ValueError(f"Duplicate unordered pair at line {line_number}")
+            seen.add(key)
+            if outer_split == "train":
+                records.append(pair)
+                counts["outer_train"] += 1
+            elif outer_split == "test":
+                counts["outer_test"] += 1
+                if not curator_allow_filter_outer_test:
+                    raise ValueError(
+                        "Input must contain only outer-train rows; a trusted migration "
+                        "must explicitly pass --curator-allow-filter-outer-test"
+                    )
+                frozen_test_records.append(pair)
+            else:
+                raise ValueError(f"Unsupported outer split at line {line_number}")
+    if not records:
+        raise ValueError("No outer-train pairs available")
+    return records, frozen_test_records, counts
+
+
+def choose_dev_runs(
+    records: Iterable[dict[str, Any]],
+    run_by_card: dict[str, str],
+    task_by_run: dict[str, str],
+    *,
+    seed: int,
+    dev_fraction: float,
+) -> set[str]:
+    if not 0.0 < dev_fraction < 0.5:
+        raise ValueError("dev_fraction must be strictly between 0 and 0.5")
+    runs_by_task: dict[str, set[str]] = defaultdict(set)
+    for pair in records:
+        for endpoint in (pair["better"], pair["worse"]):
+            run_id = run_by_card[endpoint]
+            runs_by_task[task_by_run[run_id]].add(run_id)
+
+    dev_runs: set[str] = set()
+    for task_name in sorted(runs_by_task):
+        task_runs = sorted(
+            runs_by_task[task_name],
+            key=lambda run_id: (
+                hashlib.sha256(
+                    canonical_json([seed, task_name, run_id]).encode()
+                ).hexdigest(),
+                run_id,
+            ),
+        )
+        if len(task_runs) < 2:
+            continue
+        dev_count = min(
+            len(task_runs) - 1,
+            max(1, round(len(task_runs) * dev_fraction)),
+        )
+        dev_runs.update(task_runs[:dev_count])
+    return dev_runs
+
+
+def partition_pairs(
+    records: Iterable[dict[str, Any]],
+    run_by_card: dict[str, str],
+    dev_runs: set[str],
+    *,
+    seed: int,
+) -> tuple[list[dict[str, Any]], list[dict[str, Any]], int]:
+    train_records: list[dict[str, Any]] = []
+    dev_records: list[dict[str, Any]] = []
+    dropped = 0
+    for source_pair in records:
+        pair = dict(source_pair)
+        endpoint_runs = {
+            run_by_card[pair["better"]],
+            run_by_card[pair["worse"]],
+        }
+        endpoint_is_dev = {run_id in dev_runs for run_id in endpoint_runs}
+        if len(endpoint_is_dev) != 1:
+            dropped += 1
+            continue
+        split = "dev" if endpoint_is_dev.pop() else "train"
+        pair["outer_intask_split"] = "train"
+        pair["intask_split"] = split
+        pair["train_dev_protocol"] = PROTOCOL
+        pair["train_dev_seed"] = seed
+        (dev_records if split == "dev" else train_records).append(pair)
+    if not train_records or not dev_records:
+        raise ValueError("Run split produced an empty train or dev pair pool")
+    return train_records, dev_records, dropped
+
+
+def _jsonl_bytes(records: Iterable[dict[str, Any]]) -> bytes:
+    return "".join(canonical_json(record) + "\n" for record in records).encode()
+
+
+def write_immutable(path: Path, payload: bytes) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    if path.exists():
+        if path.read_bytes() == payload:
+            return
+        raise FileExistsError(f"Immutable output already exists with other bytes: {path}")
+    temporary_path: Path | None = None
+    try:
+        with tempfile.NamedTemporaryFile(
+            mode="wb", dir=path.parent, prefix=f".{path.name}.",
+            suffix=".tmp", delete=False,
+        ) as output_file:
+            temporary_path = Path(output_file.name)
+            output_file.write(payload)
+        os.replace(temporary_path, path)
+    finally:
+        if temporary_path is not None and temporary_path.exists():
+            temporary_path.unlink()
+
+
+def build_split(
+    cards_path: Path,
+    pairs_path: Path,
+    train_output: Path,
+    dev_output: Path,
+    manifest_output: Path,
+    frozen_test_output: Path | None = None,
+    *,
+    seed: int,
+    dev_fraction: float,
+    curator_allow_filter_outer_test: bool,
+) -> dict[str, Any]:
+    run_by_card, task_by_run, config_by_card = index_cards(cards_path)
+    records, frozen_test_records, source_counts = read_outer_train_pairs(
+        pairs_path,
+        run_by_card,
+        task_by_run,
+        config_by_card,
+        curator_allow_filter_outer_test=curator_allow_filter_outer_test,
+    )
+    if curator_allow_filter_outer_test and not frozen_test_records:
+        raise ValueError("Curator mode requested but the source has no outer-test rows")
+    if curator_allow_filter_outer_test and frozen_test_output is None:
+        raise ValueError("Curator mode requires a dedicated frozen_test_output")
+    if not curator_allow_filter_outer_test and frozen_test_output is not None:
+        raise ValueError("frozen_test_output is only valid in curator mode")
+
+    outer_train_endpoints = {
+        endpoint
+        for pair in records
+        for endpoint in (pair["better"], pair["worse"])
+    }
+    outer_test_endpoints = {
+        endpoint
+        for pair in frozen_test_records
+        for endpoint in (pair["better"], pair["worse"])
+    }
+    endpoint_overlap = outer_train_endpoints & outer_test_endpoints
+    if endpoint_overlap:
+        raise ValueError(
+            f"Outer train/test Card overlap is forbidden: {len(endpoint_overlap)}"
+        )
+    outer_train_runs = {run_by_card[card_id] for card_id in outer_train_endpoints}
+    outer_test_runs = {run_by_card[card_id] for card_id in outer_test_endpoints}
+    outer_run_overlap = outer_train_runs & outer_test_runs
+    if outer_run_overlap:
+        raise ValueError(
+            f"Outer train/test physical-run overlap is forbidden: {len(outer_run_overlap)}"
+        )
+    dev_runs = choose_dev_runs(
+        records, run_by_card, task_by_run, seed=seed, dev_fraction=dev_fraction
+    )
+    train_records, dev_records, dropped = partition_pairs(
+        records, run_by_card, dev_runs, seed=seed
+    )
+
+    train_bytes = _jsonl_bytes(train_records)
+    dev_bytes = _jsonl_bytes(dev_records)
+    frozen_test_bytes = _jsonl_bytes(frozen_test_records)
+    train_runs = {
+        run_by_card[endpoint]
+        for pair in train_records
+        for endpoint in (pair["better"], pair["worse"])
+    }
+    actual_dev_runs = {
+        run_by_card[endpoint]
+        for pair in dev_records
+        for endpoint in (pair["better"], pair["worse"])
+    }
+    if train_runs & actual_dev_runs:
+        raise AssertionError("Producer generated overlapping train/dev runs")
+
+    manifest = {
+        "protocol": PROTOCOL,
+        "status": "TRAIN_DEV_SPLIT_VERIFIED_BY_PRODUCER",
+        "seed": seed,
+        "dev_fraction": dev_fraction,
+        "cards_sha256": sha256_file(cards_path),
+        "source_pairs_sha256": sha256_file(pairs_path),
+        "train_pairs_sha256": hashlib.sha256(train_bytes).hexdigest(),
+        "dev_pairs_sha256": hashlib.sha256(dev_bytes).hexdigest(),
+        "source_counts": dict(sorted(source_counts.items())),
+        "train_pairs": len(train_records),
+        "dev_pairs": len(dev_records),
+        "dropped_cross_split_pairs": dropped,
+        "train_runs": len(train_runs),
+        "dev_runs": len(actual_dev_runs),
+        "run_overlap": 0,
+        "outer_test_rows_emitted": 0,
+        "frozen_test_pairs": len(frozen_test_records),
+        "frozen_test_pairs_sha256": (
+            hashlib.sha256(frozen_test_bytes).hexdigest()
+            if frozen_test_records else None
+        ),
+        "outer_train_test_card_overlap": 0,
+        "outer_train_test_run_overlap": 0,
+        "train_run_ids_sha256": hashlib.sha256(
+            canonical_json(sorted(train_runs)).encode()
+        ).hexdigest(),
+        "dev_run_ids_sha256": hashlib.sha256(
+            canonical_json(sorted(actual_dev_runs)).encode()
+        ).hexdigest(),
+    }
+    manifest_bytes = (canonical_json(manifest) + "\n").encode()
+    write_immutable(train_output, train_bytes)
+    write_immutable(dev_output, dev_bytes)
+    if frozen_test_output is not None:
+        write_immutable(frozen_test_output, frozen_test_bytes)
+    write_immutable(manifest_output, manifest_bytes)
+    return manifest
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("cards", type=Path)
+    parser.add_argument("pairs", type=Path)
+    parser.add_argument("train_out", type=Path)
+    parser.add_argument("dev_out", type=Path)
+    parser.add_argument("manifest_out", type=Path)
+    parser.add_argument("--frozen-test-out", type=Path)
+    parser.add_argument("--seed", type=int, default=7)
+    parser.add_argument("--dev-fraction", type=float, default=0.1)
+    parser.add_argument("--curator-allow-filter-outer-test", action="store_true")
+    arguments = parser.parse_args()
+    manifest = build_split(
+        arguments.cards,
+        arguments.pairs,
+        arguments.train_out,
+        arguments.dev_out,
+        arguments.manifest_out,
+        arguments.frozen_test_out,
+        seed=arguments.seed,
+        dev_fraction=arguments.dev_fraction,
+        curator_allow_filter_outer_test=arguments.curator_allow_filter_outer_test,
+    )
+    print(canonical_json(manifest))
+
+
+if __name__ == "__main__":
+    main()
