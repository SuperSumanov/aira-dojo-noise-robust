@@ -0,0 +1,97 @@
+#!/usr/bin/env bash
+# Launch exactly one dev-selected critic fit. This script never reads a test pair file.
+set -euo pipefail
+
+source "$(dirname "$0")/../../experiment_env_augmented_data.sh"
+
+: "${CONFIRM_TRAIN_PAIRS:?set a dedicated train-only JSONL}"
+: "${CONFIRM_DEV_PAIRS:?set a dedicated train-run-derived dev-only JSONL}"
+: "${CONFIRM_CARDS:?set the immutable grouped Cards JSON}"
+: "${CONFIRM_MODEL:?set one pinned local model snapshot or model revision}"
+: "${CONFIRM_OUTPUT_DIR:?set a new output directory}"
+: "${CONFIRM_LOG_PATH:?set a new log path}"
+: "${CONFIRM_SEED:?set the preregistered seed}"
+: "${CONFIRM_PER_DEVICE_TRAIN_BATCH:?set the per-device pair batch}"
+: "${CONFIRM_PER_DEVICE_EVAL_BATCH:?set the per-device eval pair batch}"
+: "${CONFIRM_GRAD_ACCUM:?set gradient accumulation}"
+: "${CONFIRM_EXPECTED_TRAIN_SHA256:?lock the train JSONL digest}"
+: "${CONFIRM_EXPECTED_DEV_SHA256:?lock the dev JSONL digest}"
+: "${CONFIRM_EXPECTED_CARDS_SHA256:?lock the Cards digest}"
+
+CONFIRM_NUM_PROCESSES=${CONFIRM_NUM_PROCESSES:-2}
+CONFIRM_MAX_LEN=${CONFIRM_MAX_LEN:-16384}
+CONFIRM_EVAL_STEPS=${CONFIRM_EVAL_STEPS:-10}
+CONFIRM_EPOCHS=${CONFIRM_EPOCHS:-1}
+CONFIRM_LEARNING_RATE=${CONFIRM_LEARNING_RATE:-1e-5}
+CONFIRM_EFFECTIVE_PAIR_BATCH=${CONFIRM_EFFECTIVE_PAIR_BATCH:-128}
+
+[[ ! -e $CONFIRM_OUTPUT_DIR ]] || {
+    echo "refusing to reuse output directory: $CONFIRM_OUTPUT_DIR" >&2
+    exit 2
+}
+[[ ! -e $CONFIRM_LOG_PATH ]] || {
+    echo "refusing to overwrite log: $CONFIRM_LOG_PATH" >&2
+    exit 2
+}
+
+verify_sha256() {
+    local path=$1
+    local expected=$2
+    local label=$3
+    [[ -f $path ]] || { echo "$label is missing: $path" >&2; exit 2; }
+    local observed
+    observed=$(sha256sum "$path" | awk '{print $1}')
+    [[ $observed == "$expected" ]] || {
+        echo "$label SHA-256 mismatch: expected=$expected observed=$observed" >&2
+        exit 2
+    }
+}
+
+verify_sha256 "$CONFIRM_TRAIN_PAIRS" "$CONFIRM_EXPECTED_TRAIN_SHA256" train
+verify_sha256 "$CONFIRM_DEV_PAIRS" "$CONFIRM_EXPECTED_DEV_SHA256" dev
+verify_sha256 "$CONFIRM_CARDS" "$CONFIRM_EXPECTED_CARDS_SHA256" cards
+
+actual_effective_batch=$((
+    CONFIRM_NUM_PROCESSES
+    * CONFIRM_PER_DEVICE_TRAIN_BATCH
+    * CONFIRM_GRAD_ACCUM
+))
+[[ $actual_effective_batch -eq $CONFIRM_EFFECTIVE_PAIR_BATCH ]] || {
+    echo "effective pair batch mismatch: expected=$CONFIRM_EFFECTIVE_PAIR_BATCH observed=$actual_effective_batch" >&2
+    exit 2
+}
+
+mkdir -p "$(dirname "$CONFIRM_LOG_PATH")"
+export AIRA_DOJO_GIT_COMMIT
+AIRA_DOJO_GIT_COMMIT=$(git rev-parse HEAD)
+export PYTHONHASHSEED=$CONFIRM_SEED
+
+echo "[confirmatory-rm] commit=$AIRA_DOJO_GIT_COMMIT model=$CONFIRM_MODEL seed=$CONFIRM_SEED"
+echo "[confirmatory-rm] train_sha256=$CONFIRM_EXPECTED_TRAIN_SHA256 dev_sha256=$CONFIRM_EXPECTED_DEV_SHA256 cards_sha256=$CONFIRM_EXPECTED_CARDS_SHA256"
+echo "[confirmatory-rm] processes=$CONFIRM_NUM_PROCESSES effective_pair_batch=$actual_effective_batch max_len=$CONFIRM_MAX_LEN epochs=$CONFIRM_EPOCHS"
+
+accelerate launch \
+    --config_file "$ACCELERATE_CONFIG" \
+    --num_processes "$CONFIRM_NUM_PROCESSES" "$TRAIN_SCRIPT" \
+    --train_pairs "$CONFIRM_TRAIN_PAIRS" \
+    --dev_pairs "$CONFIRM_DEV_PAIRS" \
+    --cards "$CONFIRM_CARDS" \
+    --model "$CONFIRM_MODEL" \
+    --max_len "$CONFIRM_MAX_LEN" \
+    --task_cond true \
+    --budget_cond false \
+    --per_device_train_batch_size "$CONFIRM_PER_DEVICE_TRAIN_BATCH" \
+    --per_device_eval_batch_size "$CONFIRM_PER_DEVICE_EVAL_BATCH" \
+    --gradient_accumulation_steps "$CONFIRM_GRAD_ACCUM" \
+    --eval_steps "$CONFIRM_EVAL_STEPS" \
+    --learning_rate "$CONFIRM_LEARNING_RATE" \
+    --num_train_epochs "$CONFIRM_EPOCHS" \
+    --output_dir "$CONFIRM_OUTPUT_DIR" \
+    --seed "$CONFIRM_SEED" \
+    --report_to none \
+    --dataloader_num_workers 0 \
+    --save_strategy best \
+    --load_best_model_at_end true \
+    --metric_for_best_model eval_pair_accuracy \
+    --greater_is_better true \
+    2>&1 | tee "$CONFIRM_LOG_PATH"
