+class WallClockReceiptCallback(TrainerCallback):
+    """Emit machine-readable timing markers without changing optimization."""
+
+    @staticmethod
+    def _emit(event: str, state) -> None:
+        if not state.is_world_process_zero:
+            return
+        receipt = {
+            "event": event,
+            "global_step": int(state.global_step),
+            "max_steps": int(state.max_steps),
+            "monotonic_ns": time.monotonic_ns(),
+            "utc": dt.datetime.now(dt.timezone.utc).isoformat(),
+        }
+        print("[rm-timing] " + json.dumps(receipt, sort_keys=True), flush=True)
+
+    def on_train_begin(self, args, state, control, **kwargs):
+        self._emit("train_begin", state)
+
+    def on_step_end(self, args, state, control, **kwargs):
+        if state.global_step == 1:
+            self._emit("optimizer_step_1", state)
+        if state.global_step == state.max_steps:
+            self._emit("optimizer_step_final", state)
+
+    def on_evaluate(self, args, state, control, **kwargs):
+        self._emit("dev_evaluate_complete", state)
+
+    def on_train_end(self, args, state, control, **kwargs):
+        self._emit("train_end", state)
+
+
 class BradleyTerryRewardModel(nn.Module):
     def __init__(self, model_name: str):
