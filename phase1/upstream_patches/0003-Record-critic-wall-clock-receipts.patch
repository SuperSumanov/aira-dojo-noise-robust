+++ b/src/mle_critic/test/test_wall_clock_receipt_callback.py
@@ -0,0 +1,51 @@
+"""Focused tests for machine-readable G0 timing receipts."""
+
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+
+from src.mle_critic.src.train.bradley_terry import WallClockReceiptCallback
+
+
+def make_state(*, world_process_zero: bool = True):
+    return SimpleNamespace(
+        is_world_process_zero=world_process_zero,
+        global_step=0,
+        max_steps=10,
+    )
+
+
+def test_callback_emits_only_frozen_wall_clock_events(capsys):
+    callback = WallClockReceiptCallback()
+    state = make_state()
+    callback.on_train_begin(None, state, None)
+    state.global_step = 1
+    callback.on_step_end(None, state, None)
+    state.global_step = 2
+    callback.on_step_end(None, state, None)
+    state.global_step = 10
+    callback.on_step_end(None, state, None)
+    callback.on_evaluate(None, state, None)
+    callback.on_train_end(None, state, None)
+
+    rows = []
+    for line in capsys.readouterr().out.splitlines():
+        prefix = "[rm-timing] "
+        assert line.startswith(prefix)
+        rows.append(json.loads(line[len(prefix) :]))
+    assert [row["event"] for row in rows] == [
+        "train_begin",
+        "optimizer_step_1",
+        "optimizer_step_final",
+        "dev_evaluate_complete",
+        "train_end",
+    ]
+    assert [row["global_step"] for row in rows] == [0, 1, 10, 10, 10]
+    assert all(row["max_steps"] == 10 for row in rows)
+    assert all(row["monotonic_ns"] > 0 for row in rows)
+    assert all(row["utc"].endswith("+00:00") for row in rows)
+
+
+def test_non_world_process_zero_emits_nothing(capsys):
+    callback = WallClockReceiptCallback()
+    callback.on_train_begin(None, make_state(world_process_zero=False), None)
+    assert capsys.readouterr().out == ""
