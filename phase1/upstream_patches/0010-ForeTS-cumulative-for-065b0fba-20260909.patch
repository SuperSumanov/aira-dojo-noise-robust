+def _load_raw_checkpoint_offline(checkpoint_path, base_dir, meta, device_map):
+    """Strict raw-state loading on one device, with no pretrained download/init.
+
+    This opt-in path accepts local configuration/tokenizer files and a combined
+    backbone.* / head.* safetensors state. It does not support adapters, separate
+    pickle heads, or multi-device dispatch. Metadata provenance is recorded by
+    the caller; training/evaluation state is never needed here.
+    """
+    from accelerate import init_empty_weights
+    from safetensors.torch import load_file
+    from transformers import AutoConfig, AutoModel, AutoTokenizer
+
+    base_dir = Path(base_dir)
+    if not base_dir.is_dir() or not (base_dir / "config.json").is_file():
+        raise ValueError("offline_base_dir must be a local directory containing config.json")
+    if (checkpoint_path / "head.pt").exists():
+        raise ValueError("offline loading requires a combined raw safetensors checkpoint")
+    if device_map not in (None, "auto"):
+        raise ValueError("offline loading supports only one device, not a custom device map")
+    cuda = torch.cuda.is_available()
+    if cuda and torch.cuda.device_count() != 1:
+        raise ValueError("offline loading requires exactly one visible GPU; set CUDA_VISIBLE_DEVICES")
+    dtype = torch.bfloat16 if cuda else torch.float32
+    device = torch.device("cuda:0" if cuda else "cpu")
+    config = AutoConfig.from_pretrained(str(base_dir), local_files_only=True, trust_remote_code=False)
+    tokenizer = AutoTokenizer.from_pretrained(str(base_dir), local_files_only=True, trust_remote_code=False)
+    if tokenizer.pad_token is None:
+        tokenizer.pad_token = tokenizer.eos_token
+    if tokenizer.pad_token_id is None:
+        raise ValueError("tokenizer needs a pad or EOS token")
+
+    # Parameters stay on meta; non-persistent buffers (e.g. rotary frequencies)
+    # are built normally from the config, then moved together with the model.
+    with init_empty_weights(include_buffers=False):
+        model = _RewardModel(AutoModel.from_config(config, torch_dtype=dtype, trust_remote_code=False))
+    state = load_file(str(checkpoint_path / "model.safetensors"), device="cpu")
+    if "head.weight" not in state or not any(key.startswith("backbone.") for key in state):
+        raise ValueError("offline loading requires backbone.* and head.* in model.safetensors")
+    model.load_state_dict(state, strict=True, assign=True)
