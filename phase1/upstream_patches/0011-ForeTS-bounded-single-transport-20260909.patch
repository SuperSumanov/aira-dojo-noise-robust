+    async def _query_once_bounded(self, messages, request_kwargs, func_spec, transport, timeout_seconds):
+        """Opt-in single adapter attempt, no fallback/parse/SDK retries.
+
+        This is not proof of provider billing or cancellation. Safe intent/return
+        records go to the private run log; unpriced usage always has cost=None.
+        A separate whole-run cap and provider-confirmed price envelope are needed.
+        """
+        if type(timeout_seconds) not in (int, float) or not math.isfinite(timeout_seconds) or not 0 < timeout_seconds <= 300:
+            raise ValueError('bounded request timeout must be in (0, 300] seconds')
+        if type(request_kwargs.get('max_tokens')) is not int or request_kwargs['max_tokens'] <= 0:
+            raise ValueError('bounded transport requires explicit positive max_tokens')
+        kwargs = request_kwargs.copy()
+        kwargs.update(max_retries=0, num_retries=0, request_timeout=httpx.Timeout(timeout_seconds))
+        if func_spec is not None:
+            if transport == 'json':
+                messages = self._messages_with_json_schema(messages, func_spec)
+                kwargs['response_format'] = {'type': 'json_object'}
+            else:
+                kwargs['tools'] = [func_spec.as_openai_tool_dict]
+                kwargs['tool_choice'] = func_spec.openai_tool_choice_dict
+        import uuid
+        event = dict(attempt_id=uuid.uuid4().hex, state='intent', adapter_attempts=1,
+                     cost=None, cost_status='unpriced', prompt_tokens=None, completion_tokens=None,
+                     success=False, provider_cancellation_verified=False)
+        logger.info('bounded_transport %s', json.dumps(event, sort_keys=True))
+        start = time.monotonic()
+        completion = None
+        try:
+            completion = await asyncio.wait_for(completion_fn(messages=messages, **kwargs), timeout_seconds)
+            event['state'] = 'response_returned'
+            usage = completion.to_dict().get('usage') or {}
+            for name in ('prompt_tokens', 'completion_tokens'):
+                value = usage.get(name)
+                event[name] = value if type(value) is int and value >= 0 else None
+            if func_spec is None:
+                output = completion.choices[0].message.content
+            else:
+                output = self._parse_structured_output(completion, func_spec, transport)
+            event['success'] = True
+        except Exception as exc:
+            event.update(state='transport_unknown' if completion is None else 'response_invalid',
+                         error_type=type(exc).__name__)
+            # Never expose provider response/body/credentials in a retry error.
+            raise RuntimeError('bounded API attempt failed: ' + type(exc).__name__) from None
+        finally:
+            event['latency'] = time.monotonic() - start
+            logger.info('bounded_transport %s', json.dumps(event, sort_keys=True))
+        stats = dict(event)
+        p, c = stats['prompt_tokens'], stats['completion_tokens']
+        stats['total_tokens'] = p + c if p is not None and c is not None else None
+        stats['token_usage_source'] = 'provider' if p is not None and c is not None else 'provider_incomplete'
+        if func_spec is not None:
+            stats.update(structured_output_transport=transport, structured_output_requests=1)
+        return output, stats
+
