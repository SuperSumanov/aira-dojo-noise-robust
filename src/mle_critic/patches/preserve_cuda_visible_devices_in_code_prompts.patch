diff --git a/src/mle_critic/test/test_cuda_visible_devices_prompt_guard.py b/src/mle_critic/test/test_cuda_visible_devices_prompt_guard.py
new file mode 100644
--- /dev/null
+++ b/src/mle_critic/test/test_cuda_visible_devices_prompt_guard.py
@@ -0,0 +1,26 @@
+from pathlib import Path
+
+
+PROMPT_ROOT = Path("src/dojo/configs/solver/operators/mlebench")
+CODE_GENERATING_PROMPTS = [
+    PROMPT_ROOT / family / f"{operator}.yaml"
+    for family in ("aira_operators", "aide_operators")
+    for operator in ("draft", "debug", "improve", "crossover")
+]
+GUARD = (
+    "Do not set, unset, or modify the `CUDA_VISIBLE_DEVICES` environment variable; "
+    "use the GPU devices already exposed by the runtime."
+)
+
+
+def test_all_code_generating_prompts_preserve_cuda_visible_devices() -> None:
+    missing = [
+        str(path)
+        for path in CODE_GENERATING_PROMPTS
+        if GUARD not in path.read_text(encoding="utf-8")
+    ]
+
+    assert not missing, (
+        "Code-generating prompts must tell the agent to preserve "
+        f"CUDA_VISIBLE_DEVICES; missing from: {missing}"
+    )
