+def _find_ldconfig_library(
+    soname: str,
+    *,
+    run: Callable[..., subprocess.CompletedProcess[str]] = subprocess.run,
+) -> Path | None:
+    ldconfig = shutil.which("ldconfig")
+    if ldconfig is None:
+        return None
+    try:
+        result = run(
+            [ldconfig, "-p"],
+            check=False,
+            capture_output=True,
+            text=True,
+            timeout=10,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return None
+    if result.returncode != 0:
+        return None
+    for line in result.stdout.splitlines():
+        name, separator, path = line.partition("=>")
+        if separator and name.strip().split(maxsplit=1)[0] == soname:
+            candidate = Path(path.strip())
+            try:
+                resolved = candidate.resolve(strict=True)
+            except OSError:
+                continue
+            if resolved.is_file():
+                return resolved
+    return None
+
+
+def _discover_nvidia_opencl_binds(
+    *,
+    icd_path: Path = _NVIDIA_OPENCL_ICD,
+    run: Callable[..., subprocess.CompletedProcess[str]] = subprocess.run,
+) -> dict[Path, Path]:
+    """Find the host NVIDIA OpenCL files missing from legacy Singularity --nv."""
+    if not icd_path.is_file():
+        log.warning(
+            "NVIDIA OpenCL ICD was not found at %s; OpenCL workloads such as "
+            "LightGBM device='gpu' may be unavailable in the container",
+            icd_path,
+        )
+        return {}
+    try:
+        icd_entries = [
+            line.strip()
+            for line in icd_path.read_text(encoding="utf-8").splitlines()
+            if line.strip() and not line.lstrip().startswith("#")
+        ]
+    except OSError as error:
+        log.warning("Could not read NVIDIA OpenCL ICD %s: %s", icd_path, error)
+        return {}
+    if not any(
+        Path(entry).name.startswith("libnvidia-opencl.so") for entry in icd_entries
+    ):
+        log.warning(
+            "OpenCL ICD %s does not reference libnvidia-opencl; refusing to "
+            "inject it into the container",
+            icd_path,
+        )
+        return {}
+
+    nvvm = _find_ldconfig_library("libnvidia-nvvm.so.4", run=run)
+    if nvvm is None:
+        log.warning(
+            "libnvidia-nvvm.so.4 was not found through ldconfig; NVIDIA "
+            "OpenCL kernels may be discoverable but fail to compile"
+        )
+        return {}
+
+    log.info(
+        "Enabling NVIDIA OpenCL container support with ICD %s and NVVM %s",
+        icd_path,
+        nvvm,
+    )
+    return {
+        icd_path.resolve(): _CONTAINER_NVIDIA_OPENCL_ICD,
+        nvvm: _CONTAINER_NVIDIA_NVVM,
+    }
+
+
+def _merge_runtime_binds(
+    configured_binds: Mapping[Path, Path], runtime_binds: Mapping[Path, Path]
+) -> dict[Path, Path]:
+    merged = dict(configured_binds)
+    sources_by_destination = {
+        destination: source for source, destination in merged.items()
+    }
+    for source, destination in runtime_binds.items():
+        configured_source = sources_by_destination.get(destination)
+        if configured_source is not None and configured_source != source:
+            raise ValueError(
+                "Read-only Singularity bind target conflicts with an automatically "
+                f"managed NVIDIA OpenCL path: {destination}"
+            )
+        merged[source] = destination
+        sources_by_destination[destination] = source
+    return merged
+
