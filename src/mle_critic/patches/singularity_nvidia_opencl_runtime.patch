+def test_find_ldconfig_library_resolves_driver_version(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    library = tmp_path / "libnvidia-nvvm.so.610.43.02"
+    library.touch()
+    monkeypatch.setattr(
+        "dojo.core.interpreters.jupyter.singularity_jupyter_server.shutil.which",
+        lambda name: "/sbin/ldconfig" if name == "ldconfig" else None,
+    )
+
+    def fake_run(
+        command: list[str], **kwargs: object
+    ) -> subprocess.CompletedProcess[str]:
+        return subprocess.CompletedProcess(
+            command,
+            0,
+            stdout=f"\tlibnvidia-nvvm.so.4 (libc6,x86-64) => {library}\n",
+            stderr="",
+        )
+
+    assert _find_ldconfig_library("libnvidia-nvvm.so.4", run=fake_run) == library
+
+
+def test_discover_nvidia_opencl_binds_is_version_independent(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    icd = tmp_path / "nvidia.icd"
+    icd.write_text("libnvidia-opencl.so.1\n", encoding="utf-8")
+    nvvm = tmp_path / "libnvidia-nvvm.so.999.1"
+    nvvm.touch()
+    monkeypatch.setattr(
+        "dojo.core.interpreters.jupyter.singularity_jupyter_server.shutil.which",
+        lambda name: "/sbin/ldconfig" if name == "ldconfig" else None,
+    )
+
+    def fake_run(
+        command: list[str], **kwargs: object
+    ) -> subprocess.CompletedProcess[str]:
+        return subprocess.CompletedProcess(
+            command,
+            0,
+            stdout=f"libnvidia-nvvm.so.4 (libc6,x86-64) => {nvvm}\n",
+            stderr="",
+        )
+
+    assert _discover_nvidia_opencl_binds(icd_path=icd, run=fake_run) == {
+        icd.resolve(): Path("/etc/OpenCL/vendors/nvidia.icd"),
+        nvvm.resolve(): Path("/usr/local/nvidia/lib64/libnvidia-nvvm.so.4"),
+    }
